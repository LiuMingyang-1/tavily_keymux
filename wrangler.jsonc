{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tavily-keymux",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "KEY_POOL", "class_name": "TavilyKeyPool" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TavilyKeyPool"] }],
  "observability": { "enabled": false },
}
